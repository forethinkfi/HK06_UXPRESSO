# Render / local environment (never commit real values)
PORT=3000
# Gemini API key for voice ordering. Server side only; the browser never receives it.
GEMINI_API_KEY=
# Optional
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
LIVE_ENABLED=true
# LIVE_ALLOWED_ORIGINS=https://your-extra-origin.example
# LIVE_MAX_SESSIONS=5
# LIVE_MAX_PER_IP=2
# LIVE_SESSIONS_PER_HOUR=60
# LIVE_MAX_SECONDS=300
# LIVE_IDLE_SECONDS=90

# Order saving to Supabase (server side only; never commit real values, never expose to the browser).
# Without SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY the kiosk keeps working as a demo and says the order was not saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ORDERS_ENABLED=false turns saving off even when the keys are set (default: on)
ORDERS_ENABLED=true
# KIOSK_ID=KIOSK-01
